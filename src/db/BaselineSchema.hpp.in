#pragma once

#include <string_view>

namespace JiStats {

inline constexpr char kBaselineSchemaSql[] =
    R"jistats_sql(@JISTATS_BASELINE_SQL@)jistats_sql";

inline constexpr char kClaudeRedactionSql[] =
    R"jistats_sql(@JISTATS_CLAUDE_REDACTION_SQL@)jistats_sql";

inline constexpr char kChatGptDedupSql[] =
    R"jistats_sql(@JISTATS_CHATGPT_DEDUP_SQL@)jistats_sql";

inline constexpr char kQuotaPrecisionSql[] =
    R"jistats_sql(@JISTATS_QUOTA_PRECISION_SQL@)jistats_sql";

inline constexpr char kClaudeActivityDedupSql[] =
    R"jistats_sql(@JISTATS_CLAUDE_ACTIVITY_DEDUP_SQL@)jistats_sql";

inline constexpr char kKimiTaskDedupSql[] =
    R"jistats_sql(@JISTATS_KIMI_TASK_DEDUP_SQL@)jistats_sql";

// Use the same DDL for fresh and historical version 12 databases.
inline constexpr std::string_view kBaselineSchema(kBaselineSchemaSql);
inline constexpr auto kRecoveryAndExportStart = kBaselineSchema.find("-- Recovery and export metadata");
inline constexpr auto kRecoveryAndExportEnd = kBaselineSchema.find("-- Daily quota snapshot rollups");
static_assert(kRecoveryAndExportStart < kRecoveryAndExportEnd &&
              kRecoveryAndExportEnd != std::string_view::npos);
inline constexpr auto kRecoveryAndExportSql = kBaselineSchema.substr(
    kRecoveryAndExportStart, kRecoveryAndExportEnd - kRecoveryAndExportStart);

} // namespace JiStats
